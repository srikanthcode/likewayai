# ── AI Provider Keys (comma-separated for key rotation) ──
OPENROUTER_KEYS=sk-or-v1-your-key-1,sk-or-v1-your-key-2
GROQ_KEYS=gsk_your-key-1,gsk_your-key-2
MISTRAL_API_KEY=your-mistral-api-key

# Required for the TokenHarbor model family (never hardcode this)
TOKENHARBOR_API_KEY=thk_live_xxx

# LLM7 Ultimate AI Resilience Fallback (OpenAI-compatible)
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_API_KEY=unused

# ── Text-to-speech ──
# Primary: OpenAI-compatible /audio/speech endpoint (keyless by default).
# Verified model id on speech.ai.unturf.com: tts-1-f5
TTS_BASE_URL=https://speech.ai.unturf.com/v1
TTS_MODEL=tts-1-f5
TTS_API_KEY=
TTS_VOICE=alloy

# Secondary (fallback): Gemini native TTS
GEMINI_API_KEY=your-gemini-key
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE_GEMINI=Kore

# Optional: self-hosted ComfyUI for local image generation
COMFYUI_URL=http://localhost:8188

# ── MongoDB ──
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/zynthex_ai
MONGODB_DB_NAME=likeway

# ── Auth ──
JWT_SECRET=your-very-long-random-secret-here-min-32-chars
CSRF_SECRET=your-stable-csrf-hmac-secret

# Shared secret for internal server-to-server calls (Vercel -> Render)
INTERNAL_API_SECRET=your-long-random-internal-secret

# ── Google OAuth ──
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# ── Transactional Email (password reset OTPs) ──
RESEND_API_KEY=re_xxx
EMAIL_FROM="Likeway AI <onboarding@yourdomain.com>"

# ── Razorpay (optional) ──
RAZORPAY_KEY_ID=rzp_test_your_id
RAZORPAY_KEY_SECRET=your_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_id

# Recurring billing plan IDs (Razorpay Dashboard -> Subscriptions -> Plans)
RAZORPAY_PLAN_GO=plan_xxx
RAZORPAY_PLAN_PLUS=plan_xxx
RAZORPAY_PLAN_PRO=plan_xxx

# ── Stripe ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Stripe Price IDs
STRIPE_PRICE_GO=price_xxx
STRIPE_PRICE_PLUS=price_xxx
STRIPE_PRICE_PRO=price_xxx

# ── Image Generation ──
IMAGE_GENERATION_KEYS=key1,key2
# Never commit a real key here. Generate your own at https://pollinations.ai
POLLINATIONS_API_KEY=

# Image-to-image editing model (OpenRouter). e.g. google/gemini-2.5-flash-image
IMAGE_EDIT_MODEL=google/gemini-2.5-flash-image

# ── Search & Research ──
FIRECRAWL_API_KEY=fc-xxx
BRAVE_API_KEY=
TAVILY_API_KEY=tvly-xxx

# ── Advertising (free tier only) ──
# Ads render for signed-out / Core users and are never shown to paid plans.
# Leave NEXT_PUBLIC_ADS_ENABLED unset/false to disable ad rendering entirely.
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADS_CLIENT_SCRIPT_URL=

# ── Operations ──
# Bearer token required by /api/metrics. When unset the endpoint is disabled
# (fail closed) rather than public.
METRICS_API_KEY=

# Explicit escape hatch for throwaway environments that have no database.
# NEVER set this in production: it makes all writes process-local and lossy.
LIKEWAY_ALLOW_MEMORY_DB=
